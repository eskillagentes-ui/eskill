[Unit]
Description=eskill Pregao QA Playwright read-only worker
After=network-online.target redis-server.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=eskill
Group=eskill
WorkingDirectory=/home/eskill/htdocs/eskill.com.br
Environment=PREGAO_QA_BASE_URL=https://eskill.com.br
Environment=PREGAO_QA_ALLOW_PRODUCTION_READONLY=true
Environment=PREGAO_QA_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
Environment=HOME=/tmp
ExecStart=/usr/bin/php /home/eskill/htdocs/eskill.com.br/bin/pregao-qa-worker.php
Restart=always
RestartSec=2
RuntimeMaxSec=180
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=read-only
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/home/eskill/htdocs/eskill.com.br/storage/private/pregao-qa /home/eskill/htdocs/eskill.com.br/storage/logs
MemoryMax=1200M
CPUQuota=150%
StandardOutput=append:/home/eskill/htdocs/eskill.com.br/storage/logs/pregao-qa-worker.log
StandardError=append:/home/eskill/htdocs/eskill.com.br/storage/logs/pregao-qa-worker.log

[Install]
WantedBy=multi-user.target
