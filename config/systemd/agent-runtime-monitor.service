[Unit]
Description=Eskill read-only agent monitor runtime
After=network-online.target mysql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=eskill
Group=eskill
WorkingDirectory=/home/eskill/htdocs/eskill.com.br
ExecStart=/usr/bin/php /home/eskill/htdocs/eskill.com.br/bin/agent-runtime-worker.php --loop --interval=300 --environment=production --max-attempts=2
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/eskill/htdocs/eskill.com.br/storage
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eskill-agent-runtime

[Install]
WantedBy=multi-user.target
