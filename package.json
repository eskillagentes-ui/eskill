{
  "name": "eskill",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jessestainx/eskill.git"
  },
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "node scripts/run-playwright.js",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "smoke:prod": "RUN_PROD_VALIDATION=1 PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test production-validation --project=chromium",
    "smoke:prod:ui": "RUN_PROD_VALIDATION=1 PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test production-validation --project=chromium --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.0.0"
  }
}
